# Copy to .env.local (never commit it).

# Google Gemini (https://aistudio.google.com/app/apikey). Without it, local chats use canned replies.
GEMINI_API_KEY=
# Optional: override config.yaml model.name for a quick test, e.g. gemini-2.5-flash-lite
GEMINI_MODEL=

# Local testing without spending tokens (ignored in production)
MOCK_LLM=

# Production storage (Postgres). Leave empty locally to use ./data/dev-store.json
DATABASE_URL=

# Protects /admin (HTTP Basic, any username)
ADMIN_PASSWORD=

# Makes WATI link tokens stable and unguessable. 16+ random characters; never change mid-pilot.
TOKEN_SECRET=


# Real deployment only: show /admin on the public domain (with a strong ADMIN_PASSWORD)
ADMIN_PUBLIC=

# Daily sync (npm run sync): the Redash query's own API key, and the chat domain used in links
REDASH_API_KEY=
REDASH_URL=https://analytics.getlokalapp.com
CHAT_BASE_URL=
