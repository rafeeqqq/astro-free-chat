{
  "name": "astro-free-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "node --env-file-if-exists=.env.local scripts/cli.ts check",
    "preview": "node --env-file-if-exists=.env.local scripts/cli.ts preview",
    "seed": "node --env-file-if-exists=.env.local scripts/cli.ts seed",
    "test": "node --test \"tests/*.test.ts\"",
    "import": "node --env-file-if-exists=.env.local scripts/import-users.ts",
    "verify": "npm run check && npm test && tsc --noEmit && npm run lint",
    "dev:mock": "MOCK_LLM=1 DEV_FREE_SECONDS=40 next dev -p 3100",
    "gemini-test": "node --env-file-if-exists=.env.local scripts/gemini-test.ts",
    "replay": "node --env-file-if-exists=.env.local scripts/replay.ts",
    "prodcheck": "node --env-file-if-exists=.env.local scripts/cli.ts prodcheck",
    "sync": "node --env-file-if-exists=.env.local scripts/sync.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.79",
    "ai": "^7.0.113",
    "astronomy-engine": "^2.1.19",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module"
}
